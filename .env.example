# ==============================================================================
# PACY LABS PORTFOLIO (pacylabs.xyz) — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to `.env.local` for local development or configure these in
# Vercel Project Settings > Environment Variables for production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE AUTHENTICATION & DATABASE (CMS & Intercom Realtime)
# ------------------------------------------------------------------------------
# Powers admin dashboard authentication, live visitor conversations, and Realtime messaging.
# 
# Step 1: Create a project at https://supabase.com
# Step 2: Run `supabase_intercom_schema.sql` in your Supabase SQL Editor.
# Step 3: Enable Email auth in Supabase Authentication > Providers > Email.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Whitelist of emails authorized to access the `/admin` CMS dashboard.
# Multiple emails can be comma-separated: e.g. pacy@cruisehq.fun,admin@pacylabs.xyz
# Anyone signing in whose email is not on this whitelist is strictly rejected.
ADMIN_EMAILS=pacy@cruisehq.fun

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI (Native Intercom AI Chat Assistant)
# ------------------------------------------------------------------------------
# Powers the floating website Intercom with the current production model (gemini-3.8-flash).
# If omitted: Intercom falls back to intelligent static keyword matching.
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
