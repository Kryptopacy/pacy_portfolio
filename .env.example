# ==============================================================================
# PACY LABS PORTFOLIO (pacylabs.xyz) — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to `.env.local` for local development or configure these in
# Vercel Project Settings > Environment Variables for production.
#
# NOTE: The site has sensible zero-crash fallbacks for all variables, but
# configuring them unlocks the full live administrative suite, Gemini AI,
# and Realtime founder intercom takeover.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ADMIN DASHBOARD AUTHENTICATION (/admin)
# ------------------------------------------------------------------------------
# Password required to log in to `/admin` to edit projects, update profile,
# upload resumes, and respond to incoming intercom leads.
# Default if omitted: pacy2026
ADMIN_PASSWORD=pacy2026

# Secret key used to HMAC-sign the admin session cookie.
# Default if omitted: pacy-labs-secret-key-2026-default
SESSION_SECRET=your_random_secure_session_secret_here

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI (Native Intercom AI Chat Assistant)
# ------------------------------------------------------------------------------
# Powers the floating website Intercom with the gemini-2.0-flash model.
# If omitted: Intercom falls back to intelligent static keyword matching.
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. SUPABASE (Intercom Realtime Sync & Live Founder Chat)
# ------------------------------------------------------------------------------
# Connects visitor conversations and leads to Supabase.
# When configured:
#  - Visitors' chat messages and captured contacts are stored in PostgreSQL.
#  - You can view conversations in `/admin` under the Intercom tab.
#  - Replying from `/admin` pushes live founder messages to the visitor in real-time.
# Run `supabase_intercom_schema.sql` in your Supabase SQL Editor to initialize tables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# ------------------------------------------------------------------------------
# 4. GITHUB AUTO-DEPLOYMENT FROM CMS (/admin)
# ------------------------------------------------------------------------------
# GitHub Personal Access Token (classic or fine-grained) with `repo` write scope.
# When you edit projects, profile details, or upload a new PDF resume in `/admin`,
# this token commits changes directly to GitHub, triggering Vercel to rebuild
# and deploy automatically without needing local terminal commands.
GITHUB_TOKEN=ghp_your_github_personal_access_token
GITHUB_REPO=Kryptopacy/pacy_portfolio
GITHUB_BRANCH=main
